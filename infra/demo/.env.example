# The public demo's .env. Copy it to the ROOT of the demo clone (`cp infra/demo/.env.example .env`)
# and fill in the secrets. Every other setting the API knows keeps its default; the rows below are
# the ones the demo needs, or needs to be empty. Runbook: infra/README.md ("A public demo").

# Points `docker compose` at the demo stack, so no -f is needed. Run it from the clone's root.
# The compose file names the project `starterdough-demo`; do not override that with
# COMPOSE_PROJECT_NAME, reset.sh checks it before it wipes anything.
COMPOSE_FILE=infra/demo/compose.yml
# The demo's domain. Two hosts hang off it, the split a default deployment of the kit has, and the
# compose file derives every URL that goes with them from this one row:
#
#   DOMAIN        the marketing site at /, the docs under /docs
#   app.DOMAIN    the app at /, the API under /api, /rpc and the probes
#
# Both need a DNS record and a site block in the production Caddy's conf.d, so moving the demo
# means changing this row, two records and two blocks. WEB_URL, API_URL, SITE_URL and DOCS_URL
# override the derived values one by one; keeping the API on the app's origin is what lets the
# demo run production's `web` image unchanged (its Content-Security-Policy is baked in).
DOMAIN=demo.starterdough.dev

# ── Secrets. Generate each one (openssl rand -hex 32); never reuse production's ──────────────
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# ── Mail: none, on purpose ─────────────────────────────────────────────────────────────────
# Empty selects the console provider (packages/email), which in production logs "NOT SENT" and
# drops the message. The demo never sends anything from the domain that also sells the product,
# so it cannot burn that domain's sending reputation. Password reset and the emailed confirmations
# cannot complete in the demo; the nightly reset makes that moot. Booting production without a
# provider is allowed only with PUBLIC_DEMO_MODE=true, which the compose file pins.
RESEND_API_KEY=
# Sessions must not wait for a verified address, since no mail arrives. Explicitly false: the
# default is true in production, and the API refuses a demo without a provider that leaves it there.
REQUIRE_EMAIL_VERIFICATION=false
# Still validated at boot (a real-looking domain), never used to send.
EMAIL_FROM="Starterdough Demo <noreply@demo.starterdough.dev>"


# ── Images ─────────────────────────────────────────────────────────────────────────────────
# The images production runs. `docker compose pull` needs a `docker login ghcr.io` on the box
# (deploy.yml logs it in on every deploy). Empty = build here with `docker compose up -d --build`.
# Both rows are rewritten by infra/demo/update.sh on every deploy, with the namespace and the tag
# production was just given, so the demo shows the build the site sells. What is here is only the
# starting point.
IMAGE_REGISTRY=ghcr.io/starterdough/starterdough-turbo
IMAGE_TAG=latest
# The network shared with the production Caddy (infra/compose.proxy-network.yml).
# Empty = starterdough-proxy.
PROXY_NETWORK=
