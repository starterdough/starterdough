# `bun run setup` copies this to apps/docs/.env. All values are read at build time.

# Canonical origin of the documentation site (sitemap, canonical URLs). A path is allowed and becomes
# the base every link is served under: https://example.com/docs in the single-origin Caddy mode.
# The default is the `astro dev` port, so a local `astro build` works. Replace it with your public URL
# before deploying: `astro build` refuses an unset or example.com value, and `deploy:cloudflare` also
# refuses localhost, but any other build would point every absolute URL at this machine.
SITE_URL=http://localhost:4322
# API origin whose OpenAPI document the interactive reference loads:
# ${PUBLIC_API_URL}/api/v1/openapi.json. The browser fetches it, so the API's CORS must allow this site.
PUBLIC_API_URL=http://localhost:3000
# Optional. Repository these docs are edited in: adds the header's GitHub link and "Edit this page".
# Unset = neither is rendered.
DOCS_REPO_URL=
