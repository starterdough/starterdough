{
	"name": "@repo/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "The application (SvelteKit). Thin client of @repo/api; builds for Node, Cloudflare, or as a static SPA for the Tauri shells.",
	"scripts": {
		"dev": "vite dev",
		"dev:static": "ADAPTER=static vite dev --port 5175 --strictPort",
		"build": "vite build",
		"build:node": "ADAPTER=node vite build",
		"build:cloudflare": "ADAPTER=cloudflare vite build",
		"build:static": "ADAPTER=static vite build",
		"build:static:desktop": "ADAPTER=static STATIC_OUT_DIR=build-static vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "playwright install chromium",
		"test": "bun run i18n:compile && vitest --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"deploy:cloudflare": "ADAPTER=cloudflare vite build && wrangler deploy",
		"clean": "rm -rf .svelte-kit build build-static"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@orpc/tanstack-query": "catalog:",
		"@repo/api-client": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/ui": "workspace:*",
		"@sentry/sveltekit": "^10.74.0",
		"@tanstack/svelte-query": "catalog:",
		"mode-watcher": "catalog:",
		"posthog-js": "^1.428.11",
		"svelte-sonner": "catalog:",
		"sveltekit-superforms": "^2.30.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@inlang/paraglide-js": "catalog:",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "catalog:",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"uqr": "^0.1.3",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.1"
	}
}
