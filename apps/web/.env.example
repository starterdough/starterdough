# Copy to apps/web/.env (Vite loads it). Only PUBLIC_* values reach the browser.

# Where the browser (and the Tauri shells) reach the API. Must be absolute.
PUBLIC_API_URL=http://localhost:3000

# Optional: internal API origin used by server-side `load` functions during SSR
# (e.g. http://api:3000 inside Docker Compose). Defaults to PUBLIC_API_URL.
API_URL=

# Origin of the deployed web app, for round trips that leave the browser: an OAuth callback, a
# payment or portal return, an emailed link. Required for the Tauri (ADAPTER=static) builds, where
# `location.origin` is http://tauri.localhost and nothing outside the webview can resolve it; those
# flows are hidden when it is unset. Leave empty for browser deployments: the app is already at a
# routable address.
PUBLIC_WEB_URL=

# Origin of the object store the browser PUTs uploads to, e.g.
# https://<account>.r2.cloudflarestorage.com. The CSP `connect-src` is built from it (here and in
# apps/native/scripts/tauri-config.ts); a presigned upload to an origin the policy does not name is
# blocked with no visible error. Leave empty for the local storage driver, which serves uploads
# from the API origin.
PUBLIC_STORAGE_ORIGIN=

# Public demo deployment: a banner in the app, `noindex` on every page, and the controls the API
# refuses in demo mode are disabled. Same value as the root .env row. Empty = off.
PUBLIC_DEMO_MODE=

# Optional: error tracking (Sentry). Empty = the SDK is not even loaded.
# Browser errors use the public DSN; server-side (SSR) errors the private one.
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=production   SENTRY_ENVIRONMENT=production
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1   SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: product analytics (PostHog). Empty = no consent banner, nothing loaded.
# Visitors must accept the consent banner before anything is sent.
PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   (default: https://us.i.posthog.com)
