# `bun run setup` copies this to apps/web/.env (Vite loads it). Only PUBLIC_* values reach the
# browser.

# Where the browser (and the Tauri shells) reach the API. Must be absolute.
PUBLIC_API_URL=http://localhost:3000

# Optional: internal API origin used by server-side `load` functions during SSR
# (e.g. http://api:3000 inside Docker Compose). Defaults to PUBLIC_API_URL.
API_URL=

# Origin of the deployed web app, for links that leave a desktop/mobile shell, such as an emailed
# link. Required for release shell builds (`build:desktop` refuses to start without it), where
# `location.origin` is tauri://localhost or http://tauri.localhost and nothing outside the webview
# can open it. The shells offer no OAuth sign-in (apps/native/README.md). Leave empty for browser
# deployments, static hosts included: the app is already at a routable address.
PUBLIC_WEB_URL=

# An object-storage origin the app talks to directly (an S3/R2 bucket endpoint), added to the CSP
# `connect-src` here and in apps/native/scripts/tauri-config.ts. Leave empty when there is none.
PUBLIC_STORAGE_ORIGIN=

# Public demo deployment: a banner in the app and `noindex` on every page. Same value as the root
# .env row. Empty = off.
PUBLIC_DEMO_MODE=
# Where the demo banner links, e.g. your pricing page (absolute). Empty = the banner has no link.
PUBLIC_DEMO_CTA_URL=

# Optional: error tracking (Sentry). Empty = the SDK is not even loaded.
# Browser errors use the public DSN; server-side (SSR) errors the private one.
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=production   SENTRY_ENVIRONMENT=production
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1   SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: product analytics (PostHog). Empty = no consent banner, nothing loaded.
# Visitors must accept the consent banner before anything is sent.
PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   (default: https://us.i.posthog.com)
