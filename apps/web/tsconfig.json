{
	// SvelteKit writes this base on `svelte-kit sync` (node_modules/$app/tsconfig): route types,
	// the `$app/*` modules and the compiler options it needs. `#lib/*` is not a path alias any more
	// but the `imports` field of package.json, which TypeScript and Vite both resolve natively.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// `packages/tsconfig/base.json` cannot be extended here (`$app/tsconfig` is the base
		// SvelteKit owns), so its one rule that actually finds bugs is repeated: an index access
		// yields `T | undefined`, which is what turned `pages[0].storage` and `issues[0].message`
		// from silent `undefined` reads into type errors.
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "*.ts"],
	// The service worker runs in a worker, not a window, so it is its own project with its own
	// globals: src/service-worker/tsconfig.json, checked by the `check` script.
	"exclude": ["src/service-worker"]
}
