{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// `packages/tsconfig/base.json` cannot be extended here (the generated
		// `.svelte-kit/tsconfig.json` is the base SvelteKit owns), so its one rule that actually
		// finds bugs is repeated: an index access yields `T | undefined`, which is what turned
		// `pages[0].storage` and `issues[0].message` from silent `undefined` reads into type errors.
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "bundler"
	}
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// except $lib which is handled by https://svelte.dev/docs/kit/configuration#files
	//
	// To make changes to top-level options such as include and exclude, we recommend extending
	// the generated config; see https://svelte.dev/docs/kit/configuration#typescript
}
