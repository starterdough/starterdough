# Copy to apps/site/.env. Only PUBLIC_* values reach the browser; SITE_URL is read at build time.

# Canonical origin of this site, used for <link rel="canonical">, the sitemap, RSS and og:image URLs.
# `astro dev` falls back to http://localhost:4321; `astro build` REFUSES to run without a real value
# (an unset or example.com SITE_URL would ship a site whose every absolute URL points elsewhere).
SITE_URL=
# Where "Sign in" / "Open the app" and the pricing CTAs point.
PUBLIC_APP_URL=http://localhost:5173
# The Starlight documentation site.
PUBLIC_DOCS_URL=http://localhost:4322
# The API origin the contact form POSTs to (`${PUBLIC_API_URL}/api/v1/contact`). The site's origin
# must be in the API's TRUSTED_ORIGINS for the browser to be allowed to call it.
PUBLIC_API_URL=http://localhost:3000
# Optional. Your public repository: the footer link, "View on GitHub", the changelog's commit
# history and the contact page's "found a bug". Unset = none of them are rendered.
PUBLIC_REPO_URL=
# Optional. Address shown to visitors whose browser cannot run the contact form (no JavaScript).
# The form itself delivers to the API's own CONTACT_EMAIL, which never reaches the browser.
PUBLIC_CONTACT_EMAIL=
