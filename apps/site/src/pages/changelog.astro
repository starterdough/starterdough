---
import { getCollection, render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
import { formatDate, pages, repoUrl, VERSION } from '../lib/site';

const { title, description } = pages.changelog;

// Newest first: by date, then by version so same-day releases keep their order.
const compareVersions = (a: string, b: string) =>
	b.localeCompare(a, 'en', { numeric: true, sensitivity: 'base' });
const entries = (await getCollection('changelog')).sort(
	(a, b) =>
		b.data.date.getTime() - a.data.date.getTime() ||
		compareVersions(a.data.version, b.data.version),
);
const rendered = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base {title} {description}>
	<PageHeader
		eyebrow="Changelog"
		title="What shipped"
		lead="Release notes for Starterdough, newest first. The full history is in the repository."
	>
		<p class="mt-4 text-sm text-muted-foreground">
			Current version: <span class="font-mono font-medium">v{VERSION}</span>
		</p>
		{repoUrl && (
			<p class="mt-2 text-sm">
				<a
					href={`${repoUrl}/commits/main`}
					class="rounded-md underline underline-offset-4"
					rel="noopener"
				>
					Commit history on GitHub
				</a>
			</p>
		)}
	</PageHeader>

	<div class="mx-auto w-full max-w-6xl px-6 pb-20">
		<ol class="flex flex-col">
			{rendered.map(({ entry, Content }) => (
					<li class="grid gap-4 border-t border-border py-10 md:grid-cols-[12rem_1fr] md:gap-10">
						<div class="flex flex-row items-baseline gap-3 md:flex-col md:gap-1">
							<p class="font-mono text-sm font-semibold">v{entry.data.version}</p>
							<time datetime={entry.data.date.toISOString()} class="text-sm text-muted-foreground">
								{formatDate(entry.data.date)}
							</time>
						</div>
						<article id={`v${entry.data.version}`}>
							<h2 class="text-2xl font-semibold tracking-tight">{entry.data.title}</h2>
							<div class="prose mt-2">
								<Content />
							</div>
						</article>
					</li>
				))}
		</ol>
	</div>
</Base>
