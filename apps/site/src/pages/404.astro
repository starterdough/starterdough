---
import Base from '../layouts/Base.astro';
import { docsUrl, ogImagePath, pages } from '../lib/site';
---

<Base
	title="Page not found"
	description="The page you asked for does not exist."
	ogImage={ogImagePath(pages.home.ogKey)}
>
	<meta slot="head" name="robots" content="noindex">
	<section class="mx-auto flex w-full max-w-6xl flex-col items-start gap-6 px-6 py-24 md:py-32">
		<p class="font-mono text-sm text-muted-foreground">404</p>
		<h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Page not found</h1>
		<p class="max-w-md text-lg text-muted-foreground">
			The address may be wrong, or the page has moved. Try one of these instead.
		</p>
		<nav aria-label="Suggested pages" class="flex flex-wrap gap-3">
			<a
				href="/"
				class="rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90"
			>
				Home
			</a>
			<a
				href={pages.features.path}
				class="rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-accent hover:text-accent-foreground"
			>
				Features
			</a>
			<a
				href={docsUrl}
				class="rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-accent hover:text-accent-foreground"
			>
				Documentation
			</a>
		</nav>
	</section>
</Base>
