---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author, tags } = post.data;
---

<Base {title} {description} type="article" article={{ publishedTime: pubDate, author, tags }}>
	<article class="mx-auto w-full max-w-6xl px-6 pt-16 pb-20 md:pt-20">
		<header class="max-w-2xl">
			<p class="text-sm text-muted-foreground">
				<a href="/blog/" class="rounded-md hover:underline">Blog</a>
				<span aria-hidden="true"> · </span>
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				<span aria-hidden="true"> · </span>
				<span>{author}</span>
			</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{title}</h1>
			<p class="mt-4 text-lg text-muted-foreground">{description}</p>
			{tags.length > 0 && (
					<ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
						{tags.map((tag) => (
							<li class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted-foreground">
								{tag}
							</li>
						))}
					</ul>
				)}
		</header>
		<div class="prose mt-10">
			<Content />
		</div>
		<footer class="mt-12 border-t border-border pt-6 text-sm">
			<a href="/blog/" class="rounded-md text-muted-foreground hover:text-foreground"
				>← All posts</a
			>
		</footer>
	</article>
</Base>
