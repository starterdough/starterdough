---
import { appUrl, docsUrl, pages, repoLabel, repoUrl, SITE_NAME, SITE_TAGLINE } from '../lib/site';
import Logo from './Logo.astro';

const groups = [
	{
		heading: 'Product',
		links: [
			{ label: 'Features', href: pages.features.path },
			{ label: 'Changelog', href: pages.changelog.path },
			{ label: 'Open the app', href: appUrl },
		],
	},
	{
		heading: 'Resources',
		links: [
			{ label: 'Documentation', href: docsUrl },
			{ label: 'API reference', href: `${docsUrl}/reference/api-reference/` },
			{ label: 'Blog', href: pages.blog.path },
			{ label: 'RSS feed', href: '/rss.xml' },
		],
	},
	{
		heading: 'Company',
		links: [
			{ label: 'Contact', href: pages.contact.path },
			{ label: 'Privacy policy', href: pages.privacy.path },
			{ label: 'Terms of service', href: pages.terms.path },
			// Only when PUBLIC_REPO_URL names one; the kit ships no repository of its own here.
			...(repoUrl ? [{ label: 'GitHub', href: repoUrl }] : []),
		],
	},
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
	<div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">
		<div class="flex flex-col gap-3">
			<a href="/" class="flex items-center gap-2 rounded-md font-semibold tracking-tight">
				<Logo class="size-6" />
				<span>{SITE_NAME}</span>
			</a>
			<p class="max-w-xs text-sm text-muted-foreground">
				{SITE_TAGLINE}
				One HTTP API; every surface is a thin client of it.
			</p>
			{repoUrl && (
				<a
					href={repoUrl}
					class="inline-flex w-fit items-center gap-2 rounded-md text-sm text-muted-foreground hover:text-foreground"
					rel="noopener"
				>
					<svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
						></path>
					</svg>
					{repoLabel}
				</a>
			)}
		</div>

		{groups.map((group) => (
				<nav aria-label={group.heading} class="flex flex-col gap-2">
					<h2 class="text-sm font-semibold">{group.heading}</h2>
					<ul class="flex flex-col gap-2">
						{group.links.map((link) => (
							<li>
								<a
									href={link.href}
									class="rounded-md text-sm text-muted-foreground hover:text-foreground"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))}
	</div>
	<div class="mx-auto w-full max-w-6xl px-6 pb-8">
		<p class="text-xs text-muted-foreground">© {year} {SITE_NAME}. All rights reserved.</p>
	</div>
</footer>
