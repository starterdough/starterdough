# Copy to `.env` at the repo root. The API, database tooling and Docker Compose read this file.
# The SvelteKit app has its own `apps/web/.env` (see apps/web/.env.example).
#
# Three parts. You only need PART 1 while developing:
#   PART 1  Application     the API, the worker and the host tooling (db:migrate, admin:create)
#   PART 2  Self-hosting    infra/compose.yml and infra/scripts/* only; ignored by `bun run dev`
#   PART 3  Backups         the `backup` compose profile only
# One file because compose `env_file:` takes exactly one.

# ════════════════════════════════════════════════════════════════════════════
# PART 1 · Application
# ════════════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin of the API (what browsers and shells call) and of the web app (CORS, auth
# redirects, trusted origins). Empty = localhost defaults in dev (http://localhost:3000 and
# http://localhost:5173). Compose derives https://api.DOMAIN / https://app.DOMAIN in subdomains
# mode. Set both explicitly in single-origin mode.
API_URL=
WEB_URL=
# Deployed origin of the web app as the browser sees it. Only the desktop/mobile shells need it:
# their own origin is `tauri.localhost`, which no external provider can redirect back to, so OAuth
# and similar return trips go here instead. Unset, the buttons that start them are hidden.
# Same value as WEB_URL, but baked into the shell at BUILD time; the browser deployment leaves it
# empty. Set it where the shell is built: .github/workflows/desktop.yml reads it as a repository
# variable, `apps/web/.env` for a hand build. The compose stack does not pass it to the web container.
PUBLIC_WEB_URL=
# Extra origins allowed to call the API: Tauri shells, LAN devices, tailnet hosts (comma-separated).
# In production also list the marketing site and the docs (their contact form and API reference
# call the API from the browser), e.g. https://example.com,https://docs.example.com. Outside
# production http://localhost:4321 and :4322 are allowed automatically.
TRUSTED_ORIGINS=tauri://localhost,http://tauri.localhost
# Set when web + api share a parent domain (e.g. ".example.com") so the session cookie spans
# subdomains. A bare HOSTNAME, never a URL: it goes verbatim into the cookie's `Domain=`, and a
# browser silently drops a `Set-Cookie` whose Domain is `https://example.com`. Leave it empty unless
# web and api are on different hosts under one domain (single-origin mode: always empty).
COOKIE_DOMAIN=
# Public demo deployment. `true` shows a banner in the app and asks search engines not to index
# it. Read by the API (this file) and by the web app (apps/web/.env, or the web container's
# environment). Empty = off.
PUBLIC_DEMO_MODE=

# ── Database ────────────────────────────────────────────────────────────────
# Host port of the Postgres container, on loopback. `bun run db:up` in dev and infra/compose.yml in
# production both publish 127.0.0.1:POSTGRES_PORT (psql and the admin bootstrap from a host checkout
# connect there). Compose falls back to 5432 only when the row is empty. 5433 keeps it clear of a
# local Postgres on 5432.
POSTGRES_PORT=5433
# Development credentials. In production the API rejects a URL whose password is `starterdough`,
# `postgres` or a `change-me…` placeholder. The compose stack builds its own URL from
# POSTGRES_PASSWORD, so this row only matters for tooling you run on the host (db:migrate,
# db:studio, admin:create). A managed database reached over the public internet needs
# `?sslmode=require` (or the provider's equivalent).
DATABASE_URL=postgres://starterdough:starterdough@localhost:5433/starterdough

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Required, at least 32 characters, and no `change-me…` placeholder in production. Ships empty.
# Generate one:
#   openssl rand -hex 32
# Without openssl:
#   bun -e "console.log(crypto.randomUUID().replaceAll('-','') + crypto.randomUUID().replaceAll('-',''))"
# Keep it with your backups: a database restored without this value cannot validate any session.
BETTER_AUTH_SECRET=
# Require a verified email before a session is issued. Defaults to true in production,
# false otherwise (the console email provider prints the verification link during development).
REQUIRE_EMAIL_VERIFICATION=
# Social sign-in: a provider is enabled when both values are present.
# Callback URLs to register: ${API_URL}/api/auth/callback/github and /callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Email ───────────────────────────────────────────────────────────────────
# Sender of every transactional email (verification, password reset). In production it
# must be an address on a domain you have verified with your provider. Resend rejects `localhost`
# and any unverified domain, and the failure shows up as "the verification email never arrived".
# The display name is optional: `noreply@your-domain.com` alone is valid. In production the API
# refuses to boot while the domain is localhost, example.*, reserved or dotless.
EMAIL_FROM="Starterdough <noreply@example.com>"
# Empty = log emails to the console. Development only: the API refuses to boot in production
# without it, because the console provider would swallow every verification and reset email.
RESEND_API_KEY=
# Where the public site's contact / waitlist form (POST /api/v1/contact) is delivered.
# Empty is fine while emails go to the console; with Resend set, the form answers 412 until this is filled.
CONTACT_EMAIL=


# ── Operations ─────────────────────────────────────────────────────────────
# Log format of the API and worker: JSON lines in production, human-readable otherwise. Override: json | pretty
LOG_FORMAT=
# How much the API and worker log: debug | info | warn | error. Empty = info in production, debug otherwise.
LOG_LEVEL=
# Trust the first X-Forwarded-For hop as the client address (per-IP rate limits, the access log),
# and only when the header holds exactly one address; a chain of hops falls back to the socket.
# Turn it on only when a reverse proxy you control sets that header, otherwise any client can pick
# the address it is limited by. infra/compose.yml sets it on the api service, which sits behind
# Caddy. Leave it empty (false) whenever the API port is reachable without the proxy.
TRUST_PROXY=
# OpenTelemetry traces from the API, worker and AI service. Empty = off. Any OTLP/HTTP collector
# works: the `observability` compose profile (http://lgtm:4318), Grafana Cloud, Axiom, Honeycomb.
# Hosted collectors usually want a header, e.g. "Authorization=Bearer …" (comma-separated key=value pairs).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# No OTEL_SERVICE_NAME row on purpose: one env_file feeds api, worker and migrate, so a value here
# would label all of them the same. infra/compose.yml sets starterdough-api / starterdough-worker /
# starterdough-ai per service; set it in the process environment when you run one outside compose.
# Postgres connections held by one API or worker process. Postgres allows 100 by default. Keep the
# total below that: this many per api and per worker, 2 for migrate while it runs, 1 for backup.
DATABASE_POOL_MAX=10

# ════════════════════════════════════════════════════════════════════════════
# PART 2 · Self-hosting. Read by infra/compose.yml and infra/scripts/* only.
# Nothing below affects `bun run dev`; skip the whole part while developing.
# ════════════════════════════════════════════════════════════════════════════

# ── Self-hosting (infra/compose.yml) ────────────────────────────────────────
# Not a row: GIT_TOKEN is passed on infra/scripts/provision.sh's command line when the fork is
# private (`sudo REPO_URL=… GIT_TOKEN=<PAT with read access> bash provision.sh`). It is used for
# the initial clone only, never written to .git/config, to this file, or handed to a container.
# Run `docker compose …` from the repository root: this line points it at infra/compose.yml and the
# stack reads THIS file for its settings (`docker compose -f infra/compose.yml` would not).
COMPOSE_FILE=infra/compose.yml
# Prefix of every container, network and VOLUME this stack creates (`starterdough_pgdata`,
# `starterdough_uploads`, `starterdough_backups`, `starterdough_caddy_data`).
# ⚠ Renaming it after the first `up` does NOT rename the volumes: Compose creates a fresh empty set
# under the new prefix and the old ones become orphans, so the database and every uploaded document
# appear to have vanished. To move them, stop the stack and copy each volume:
#   docker volume create <new>_pgdata
#   docker run --rm -v starterdough_pgdata:/from -v <new>_pgdata:/to alpine sh -c 'cd /from && cp -a . /to'
# (repeat for uploads, backups, caddy_data, caddy_config, uptime_kuma, lgtm_data), then start again
# and only then `docker volume rm` the old ones. Renaming the product is a separate job.
COMPOSE_PROJECT_NAME=starterdough
# Optional services, comma-separated: backup (nightly pg_dump), monitoring (Uptime Kuma),
# observability (Grafana). Keep them HERE
# rather than passing --profile on the command line: infra/scripts/deploy.sh runs
# `up --remove-orphans`, which deletes the containers of every profile that is not active right then.
COMPOSE_PROFILES=
# Loopback host ports of the monitoring / observability UIs (defaults 3001 and 3030).
UPTIME_KUMA_PORT=
GRAFANA_PORT=
# The domain the public layout serves: DOMAIN, app.DOMAIN, api.DOMAIN, docs.DOMAIN, with automatic
# HTTPS from Let's Encrypt. Ships EMPTY on purpose: a placeholder would have Caddy request an ACME
# certificate for a domain you do not own, retrying forever. Empty falls back to `localhost` and
# Caddy's internal CA: the stack comes up, the browser warns about the certificate, and nothing is
# attempted against Let's Encrypt. Fill it in (and point the four DNS records at this host) when
# you go public. Not used with CADDY_MODE=single-origin; set WEB_URL / API_URL / DOCS_URL instead.
DOMAIN=
# Contact address for Let's Encrypt: expiry warnings and account recovery. Optional, but it is the
# only notice you get before a certificate that stopped renewing runs out.
ACME_EMAIL=
# Used for the postgres container AND the API's connection string. Required by the compose stack:
# `docker compose` stops with a message while it is empty, so the database never starts on a
# guessable password. Generate one:  openssl rand -hex 16
# Changing it after the first start does not change the database's password (the volume already exists).
POSTGRES_PASSWORD=
# "subdomains" (public: app./api./docs. under DOMAIN, automatic HTTPS) or "single-origin" (tailnet/LAN,
# one origin with path routing; set WEB_URL and API_URL above to that same origin)
CADDY_MODE=subdomains
# Host address Caddy binds: 127.0.0.1 for a tailnet/LAN box behind `tailscale serve`/`funnel` (it
# proxies to loopback; Docker publishes ports past ufw, so 0.0.0.0 would be public whatever the
# firewall says), 0.0.0.0 for a public box. Empty = 0.0.0.0; infra/scripts/provision.sh sets it from EXPOSE.
CADDY_BIND=
# Host ports Caddy binds. Behind Tailscale serve/funnel only 80 is used.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Where `docker compose pull` gets the images: YOUR fork's GHCR namespace (ghcr.io/<owner>/<repo>,
# lowercase), which is what .github/workflows/deploy.yml pushes to. infra/scripts/provision.sh derives
# it from REPO_URL, and deploy.sh pins whatever the workflow passed. Edit it by hand only if you host
# the images elsewhere. Ships EMPTY on purpose: compose then falls back to the local namespace
# `starterdough/<name>:local`, so `docker compose pull` fails with "pull access denied" instead of
# fetching a stranger's build, while `docker compose up -d --build` works unchanged.
# IMAGE_TAG: a commit (sha-abc1234), `main` or `latest`; infra/scripts/deploy.sh sets it per deploy, so
# a rollback is just an older tag. `docker compose up -d --build` ignores both and builds here.
IMAGE_REGISTRY=
IMAGE_TAG=latest
# Canonical URLs baked into the static sites (the caddy image). Empty = derived from DOMAIN in the
# subdomain layout. Single-origin: DOCS_URL=https://<host>/docs (the marketing site is not served there).
# Empty is fine for compose (it resolves to https://localhost), but the Astro builds refuse an unset or
# example.com value, so a published deploy needs the real domains here, or in DOMAIN.
SITE_URL=
DOCS_URL=
# Error tracking / analytics for the web container (same names as apps/web/.env). Environment defaults
# to production, the trace sample rates to 0.1.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# ════════════════════════════════════════════════════════════════════════════
# PART 3 · Backups. The `backup` compose profile only (COMPOSE_PROFILES above)
# ════════════════════════════════════════════════════════════════════════════

# ── Backups (compose --profile backup → infra/backup) ─────────────────────
# Where the dumps are written. infra/compose.yml pins it to /backups (the `backups` volume) for the
# container, so this row only matters when you run the tool from a checkout on the host.
BACKUP_DIR=./backups
# Cron (UTC) and how many days of backups to keep, on disk and in the bucket.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION_DAYS=14
# Run one backup immediately when the scheduler starts, instead of waiting for BACKUP_SCHEDULE. Off by
# default; `true` proves a fresh box can back up without waiting until 02:30.
BACKUP_ON_START=
# Run one backup at start when the newest set is older than one schedule interval (Bun.cron has no
# catch-up, so a reboot past BACKUP_SCHEDULE would otherwise skip the night). Default: true.
BACKUP_CATCHUP=
# `list` exits 1 when the newest restorable set is older than this. Duration: 90s, 45m, 36h, 2d.
BACKUP_MAX_AGE=36h
# Ceiling on pg_dump / pg_restore / tar. Default 360 (6 h).
BACKUP_COMMAND_TIMEOUT_MINUTES=
# lock_timeout for a restore session, so a live restore fails instead of hanging on a writer's lock.
BACKUP_LOCK_TIMEOUT=60s
# Off-box copy. Empty = backups stay on the `backups` volume of the same machine (the tool warns
# about it).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# A real region (us-east-1, eu-central-1, …). `auto` is only accepted together with a
# BACKUP_S3_ENDPOINT; it is an R2/MinIO convention, and AWS S3 rejects it.
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=backups/
# Pinged (GET) after each successful backup. A Healthchecks.io check, an Uptime Kuma push monitor or
# a Better Stack heartbeat then alerts you when backups stop.
BACKUP_HEARTBEAT_URL=
