{
	"name": "starterdough",
	"private": true,
	"version": "0.3.0",
	"description": "Bun-native, serve-anywhere SaaS starter: SvelteKit app, Astro sites, Hono + oRPC API, Postgres, Tauri shells.",
	"license": "SEE LICENSE IN LICENSE.md",
	"packageManager": "bun@1.4.2",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "warn"
		}
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"infra/*"
		],
		"catalog": {
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"zod": "^4.5.4",
			"hono": "^4.13.7",
			"@orpc/client": "^1.15.0",
			"@orpc/contract": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/server": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"better-auth": "^1.7.3",
			"@better-auth/passkey": "^1.7.3",
			"drizzle-orm": "^0.45.2",
			"drizzle-kit": "^0.31.10",
			"resend": "^6.26.0",
			"@t3-oss/env-core": "^0.13.11",
			"@hono/otel": "^1.1.2",
			"@opentelemetry/api": "^1.9.1",
			"@opentelemetry/sdk-trace-base": "^2.11.0",
			"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
			"@opentelemetry/resources": "^2.11.0",
			"@opentelemetry/context-async-hooks": "^2.11.0",
			"@opentelemetry/core": "^2.11.0",
			"@opentelemetry/semantic-conventions": "^1.43.0",
			"svelte": "^5.57.0",
			"svelte-check": "^4.6.0",
			"@sveltejs/kit": "^2.70.3",
			"@sveltejs/vite-plugin-svelte": "^7.1.2",
			"@sveltejs/adapter-node": "^5.5.7",
			"@sveltejs/adapter-static": "^3.0.10",
			"@sveltejs/adapter-cloudflare": "^7.2.9",
			"vite": "^8.2.2",
			"vitest": "^4.1.8",
			"tailwindcss": "^4.3.3",
			"@tailwindcss/vite": "^4.3.3",
			"astro": "^7.3.2",
			"clsx": "^2.1.1",
			"tailwind-merge": "^3.6.0",
			"bits-ui": "^2.19.1",
			"tailwind-variants": "^3.3.1",
			"tw-animate-css": "^1.4.0",
			"@lucide/svelte": "^1.43.0",
			"svelte-sonner": "^1.2.1",
			"mode-watcher": "^1.1.0",
			"@orpc/tanstack-query": "^1.15.0",
			"@tanstack/svelte-query": "^6.1.48",
			"@inlang/paraglide-js": "^2.25.1"
		}
	},
	"scripts": {
		"dev": "turbo dev",
		"doctor": "bun --no-env-file scripts/doctor.ts",
		"dev:app": "turbo dev --filter=@repo/web --filter=@repo/api",
		"dev:site": "turbo dev --filter=@repo/site",
		"dev:docs": "turbo dev --filter=@repo/docs",
		"dev:api": "turbo dev --filter=@repo/api",
		"dev:desktop": "bun run --filter @repo/native dev:desktop",
		"preview:desktop": "bun run --filter @repo/native preview:desktop",
		"build:desktop": "bun run --filter @repo/native build:desktop",
		"build": "turbo build",
		"check": "turbo check",
		"test": "bun test scripts/doctor.test.ts scripts/load-site-env.test.ts && bun test infra/scripts/deployment-recovery.test.ts infra/scripts/recover-deployment-transport.test.ts infra/demo/reset.test.ts && turbo test",
		"test:e2e": "turbo test:e2e",
		"verify": "bun run lint && bun run check && bun run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "turbo clean",
		"db:up": "docker compose -f infra/compose.dev.yml up -d",
		"db:down": "docker compose -f infra/compose.dev.yml down",
		"db:generate": "bun run --filter @repo/db generate",
		"db:migrate": "bun run --filter @repo/db migrate",
		"db:push": "bun run --filter @repo/db push",
		"db:studio": "bun run --filter @repo/db studio",
		"auth:schema": "bun run --filter @repo/auth schema",
		"admin:create": "cd packages/auth && bun run create-admin --",
		"api:openapi": "bun run --filter @repo/api openapi",
		"licenses": "bun scripts/licenses.ts",
		"rename": "bun scripts/rename.ts",
		"prepare": "lefthook install 2>/dev/null || true; bun run --cwd apps/web prepare 2>/dev/null || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	}
}
